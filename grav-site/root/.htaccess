# Grav CMS .htaccess — valentinarussobg5.com
# Questo file va rinominato in .htaccess nella root di public_html
# NOTA: sostituisce quello installato da Grav. Aggiunge redirect www → non-www.

# Disabilita visualizzazione directory
Options -Indexes

## Security headers (pentest 11/05/2026)
## CSP non incluso: richiede audit dei domini inline scripts/fonts/cdn prima di applicare.
<IfModule mod_headers.c>
    # HSTS — forza HTTPS per 1 anno (HIGH fix)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Anti-clickjacking (MEDIUM fix)
    Header set X-Frame-Options "SAMEORIGIN"

    # Anti MIME-sniffing (MEDIUM fix)
    Header set X-Content-Type-Options "nosniff"

    # Anti Referer leakage cross-origin (MEDIUM fix)
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Limita feature browser potenti (LOW fix)
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), interest-cohort=()"
</IfModule>

# Charset UTF-8 per file di testo
AddCharset UTF-8 .txt .md .json .xml

# Abilita mod_rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On

    ## REDIRECT www → non-www
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    ## REDIRECT HTTP → HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    ## REDIRECT vecchi URL WordPress → Grav equivalenti (301)
    RewriteRule ^2025/02/03/relazioni-e-bisogni-emotivi/?$ /blog/articoli/relazioni-bisogni-emotivi [R=301,L]
    RewriteRule ^category/la-mente-innamorata/?$ /blog [R=301,L]

    # Errori 5xx rimasti in Search Console al 04/09/2026.
    # /carriera-aziende esisteva sul vecchio sito: la sezione ora e' /aziende.
    RewriteRule ^carriera-aziende/?$ /aziende [R=301,L]
    # L'articolo dietro questo indirizzo non e' mai stato ripubblicato: si manda al blog.
    RewriteRule ^2025/03/24/la-mente-innamorata1/?$ /blog [R=301,L]
    # /ephe era una cartella di servizio e non tornera'. Il 410 sarebbe il segnale
    # piu' netto per Google, ma su questo hosting la regola non scatta: la richiesta
    # arriva comunque a Grav, che risponde 404. Va bene lo stesso, il 404 toglie
    # l'URL dall'indice, solo un po' piu' lentamente.
    RewriteRule ^ephe(/.*)?$ - [R=410,L]
    RewriteRule ^info-contatti/?$ /contatti [R=301,L]
    RewriteRule ^sistema-mentecorpo/?$ /servizi [R=301,L]
    RewriteRule ^wp-admin/?$ / [R=301,L]
    RewriteRule ^wp-login\.php$ / [R=301,L]
    RewriteRule ^feed/?$ / [R=301,L]

    ## Due URL sbagliate finite nell'indice di Google (una lettera di troppo,
    ## e un residuo '-copy' di un duplicato): le mandiamo sull'articolo vero
    RewriteRule ^aziende/blog/bg5-transizione-2027-preparare-azienda-cambio-ciclico/?$ /aziende/blog/bg5-transizione-2027-preparare-azienda-cambio-ciclo [R=301,L]
    RewriteRule ^aziende/blog/bg5-selezione-personale-assumere-design-copy/?$ /aziende/blog/bg5-selezione-personale-assumere-design [R=301,L]

    ## REDIRECT admin.php → /admin (Grav Admin)
    RewriteRule ^admin\.php$ /admin [R=301,L]

    ## Sitemap dinamica
    RewriteRule ^sitemap\.xml$ sitemap.xml.php [L]

    ## Pagina /links → file statico links.html (Linktree-style, fuori da Grav)
    RewriteRule ^links/?$ /links.html [L]

    # Iscrizione alla lezione gratuita del 14 settembre.
    # Il primo indirizzo era /lezione-gratuita, gia' pubblicato su YouTube:
    # resta valido e porta al nuovo, che dice di cosa si tratta.
    RewriteRule ^lezione-gratuita/?$ /lezione-gratuita-human-design [R=301,L]
    RewriteRule ^lezione-gratuita-human-design/?$ /lezione-gratuita.php [L]

    ## /blog/{slug} → /blog/articoli/{slug} (301)
    ## Gli articoli "nuovi" vivono in pages/04.blog/articoli/, ma Google indicizza /blog/{slug}.
    ## Senza questa redirect Grav crasha (500). Restano fuori solo i quattro slug
    ## che non esistono piu' da nessuna parte (non pubblicati): per quelli un 404
    ## diretto e' meglio di un 301 verso un 404.
    ## /blog/articoli (la cartella, senza articolo) -> /blog
    ## senza questa riga la regola sotto lo manda su /blog/articoli/articoli (404)
    RewriteRule ^blog/articoli/?$ /blog [R=301,L]

    RewriteCond %{REQUEST_URI} !^/blog/articoli/
    RewriteCond %{REQUEST_URI} !^/blog/(la-mente-innamorata-[123]|potere-creativo-malinconia)/?$ [NC]
    RewriteRule ^blog/([^/]+)/?$ /blog/articoli/$1 [R=301,L]

    ## Blocca accesso a file sensibili (non system/assets né themes/plugins — contengono CSS/JS)
    RewriteRule ^(\.git|cache|bin|logs|backup|vendor|webserver-configs)(/|$) [F,L]
    RewriteRule ^user/(config|data|accounts)(/|$) [F,L]
    RewriteRule ^(system/src|system/vendor)(/|$) [F,L]
    RewriteRule \.(?:yaml|twig|md)$ [F,L]

    ## Servi file statici direttamente
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.php [QSA,L]
</IfModule>

# Tipi MIME utili
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>

# Compressione gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
