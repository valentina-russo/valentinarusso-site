{% extends 'partials/base.html.twig' %}



{% block title %}Manuale d'Istruzioni Human Design in PDF | Valentina Russo{% endblock %}

{% block schema %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": "Il tuo Libretto d'Istruzioni Human Design",
  "description": "Documento PDF personalizzato che traduce la tua carta Human Design in linguaggio pratico: come sei fatta, come decidi, come lavori, come ti ricarichi. Consegnato in 2–4 giorni lavorativi.",
  "url": "{{ grav.base_url_absolute }}/libretto-istruzioni",
  "brand": { "@id": "{{ grav.base_url_absolute }}/#valentina-russo" },
  "offers": [
    {
      "@type": "Offer",
      "name": "Libretto Base",
      "description": "4 capitoli, ~35 pagine, identità energetica completa",
      "price": "90",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "deliveryLeadTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 4, "unitCode": "DAY" }
    },
    {
      "@type": "Offer",
      "name": "Libretto Avanzato",
      "description": "7 capitoli, ~55 pagine, identità completa con applicazione a comunicazione e lavoro",
      "price": "147",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "deliveryLeadTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 4, "unitCode": "DAY" }
    }
  ]
}
</script>
{% endblock %}

{% block classe_corpo %}pg-libretto{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/libretto-d2.css?v={{ theme_version }}">
{% endblock %}

