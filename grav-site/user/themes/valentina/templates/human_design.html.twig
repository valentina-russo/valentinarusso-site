{% extends 'partials/base.html.twig' %}


{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ page.header.seo_title|json_encode|raw }},
  "description": {{ (page.header.seo_desc ?? '')|json_encode|raw }},
  "abstract": {{ (page.header.aeo_answer ?? '')|json_encode|raw }},
  "url": "{{ page.url(true) }}",
  "author": {
    "@type": "Person",
    "name": "Valentina Russo",
    "url": "{{ grav.base_url_absolute }}/chi-sono",
    "jobTitle": "Consulente Certificata BG5® e Human Design",
    "sameAs": ["https://www.instagram.com/valentinarussobg5/", "{{ grav.base_url_absolute }}"]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Valentina Russo",
    "url": "{{ grav.base_url_absolute }}"
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".aeo-box", "h1"]
  }
}
</script>

{% if page.header.faq is defined and page.header.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in page.header.faq %}
    {
      "@type": "Question",
      "name": {{ (faq.question ?? faq.q)|json_encode|raw }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ (faq.answer ?? faq.a)|json_encode|raw }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ grav.base_url_absolute }}" },
    { "@type": "ListItem", "position": 2, "name": "Cos'è lo Human Design", "item": "{{ page.url(true) }}" }
  ]
}
</script>
{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/guida-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
<div class="rv-d2">

<section class="hd-hero">
<div class="hd-hero-inner">
<div class="hd-hero-text">
<span class="hd-badge">Guida per chi inizia</span>
<h1>Cos'&#232; lo Human Design?</h1>
<p class="hero-lead aeo-answer"><strong>Lo Human Design</strong> &#232; un sistema di analisi logica dell'energia individuale, calcolato da data, ora e luogo di nascita, che combina astrologia, I Ching, Chakra e genetica in una mappa personale chiamata Bodygraph. Non &#232; un sistema di credenze: individua il tuo Tipo Energetico, la tua Strategia e la tua Autorit&#224; Interna, i tre dati che stabiliscono come sei progettato per agire, decidere e relazionarti.</p>
<p class="hero-lead">Una mappa del tuo funzionamento unico: come prendi decisioni, dove metti energia, perch&#233; certe situazioni ti esauriscono e altre ti ricaricano.</p>
<div class="cta-row">
<a href="{{ base }}/calcolo-human-design" class="btn btn-1">Calcola gratis la tua carta</a>
</div>
</div>
<div class="hd-hero-visual">
<div class="hd-demo-carousel">
