{% block scripts %}
<script>
(function(){
  var s=[].slice.call(document.querySelectorAll('.hd-demo-slide')), l=document.getElementById('hd-type-label'); if(!s.length) return;
  var i=0; function mostra(n){ s.forEach(function(x,k){x.classList.toggle('visibile',k===n)}); if(l) l.textContent=s[n].getAttribute('alt')||''; }
  var ridotto = !!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches);
  mostra(0);
  // con le animazioni ridotte le carte cambiano lo stesso, ma senza dissolvenza
  setInterval(function(){ i=(i+1)%s.length; mostra(i); }, ridotto ? 4500 : 3400);
})();
</script>
{% endblock %}
