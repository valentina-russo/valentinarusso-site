{% extends 'partials/base.html.twig' %}


{% block schema %}
{{ parent() }}
{% set collection = page.collection() %}
{% set latest_date = page.modified|date('c') %}
{% if collection is not empty %}{% set latest_date = collection|first.date|date('c') %}{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "{{ page.url(true) }}#blog",
  "url": "{{ page.url(true) }}",
  "name": "{{ page.title }} | Valentina Russo",
  "description": "{{ page.header.description ?? 'Articoli su Human Design, BG5®, carriera e sviluppo personale.' }}",
  "inLanguage": "it",
  "dateModified": "{{ latest_date }}",
  "isPartOf": { "@type": "WebSite", "url": "{{ grav.base_url_absolute }}" }{% if collection is not empty %},
  "blogPost": [
    {% for article in collection|slice(0, 5) %}
    {
      "@type": "BlogPosting",
      "headline": {{ article.title|json_encode|raw }},
      "url": "{{ article.url(true) }}",
      "datePublished": "{{ article.date|date('c') }}",
      "dateModified": "{{ article.modified|date('c') }}"{% if article.header.description is defined %},
      "description": {{ article.header.description|json_encode|raw }}{% endif %}{% if article.header.author is defined %},
      "author": { "@type": "Person", "name": {{ article.header.author|json_encode|raw }} }{% endif %}
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]{% endif %}
}
</script>
{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/blog-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
{% set collection = page.collection() %}
<header class="hero bl-hero"><div class="wrap">
  <div class="bl-testa"><h1>{{ page.title }}</h1>{% if page.header.description %}<p class="bl-sotto">{{ page.header.description }}</p>{% endif %}</div>
</div></header>

<section class="bl-lista"><div class="wrap">
  <form class="bl-cerca" id="bl-form" role="search"><label for="bl-q" class="etich">Cerca negli articoli</label><div class="bl-riga"><input id="bl-q" type="search" placeholder="Parola, tema, tipologia..." autocomplete="off"><button class="btn btn-1" type="submit">Cerca</button></div></form>
  <p class="bl-conta"><span id="bl-conta"></span></p>
    <div class="bl-griglia" id="bl-griglia">
    {% for article in collection %}
    {# immagine della scheda: stessa scala di priorita' di prima, ma il ritaglio
       760x475 lo genera Grav, cosi' la miniatura pesa poco #}
    {% set media = null %}
    {% set fallback = '' %}
    {% if article.header.featured_image is defined and article.header.featured_image %}
      {% set nome = article.header.featured_image|split('/')|last %}
      {% if article.media[nome] is defined %}{% set media = article.media[nome] %}
      {% elseif article.header.featured_image starts with '/' or article.header.featured_image starts with 'http' %}
        {% if '/user/pages/' not in article.header.featured_image %}{% set fallback = article.header.featured_image %}{% endif %}
      {% endif %}
    {% endif %}
    {% if not media and not fallback and article.media|length %}{% set media = article.media|first %}{% endif %}
    {% set img = media ? media.cropZoom(760,475).quality(82).url : fallback %}
    <article class="bl-card">
      {% if img %}<a class="bl-img" href="{{ article.url }}" tabindex="-1" aria-hidden="true"><img src="{{ img }}" alt="{{ article.header.image_alt ?? article.title }}" loading="lazy" width="760" height="475"></a>{% endif %}
      <div class="bl-corpo">
        <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
        {% if article.header.tags is defined and article.header.tags %}
        <p class="bl-tag">{% for tag in (article.header.tags is iterable ? article.header.tags : article.header.tags|split(',')) %}{{ tag|trim }}{% if not loop.last %} &middot; {% endif %}{% endfor %}</p>
        {% endif %}
        {% if article.header.description is defined %}<p class="bl-estr">{{ article.header.description|slice(0,150) }}{% if article.header.description|length > 150 %}...{% endif %}</p>{% endif %}
        <p class="bl-meta">{{ article.date|date("d M Y") }}{% if article.header.author is defined %} &mdash; {{ article.header.author }}{% endif %}</p>
        <a class="lnk" href="{{ article.url }}" aria-label="Leggi: {{ article.title }}">Leggi &rarr;</a>
      </div>
    </article>
    {% endfor %}
  </div>
</div>
  <p class="bl-vuoto" id="bl-vuoto" hidden>Nessun articolo per questa ricerca.</p>
</div></section>

<section class="fine"><div class="wrap">
  <h2>Cominciamo il tuo percorso?</h2><p>Scegli il punto di ingresso che si adatta a te adesso.</p>
  <div class="azioni"><a class="btn btn-1" href="{{ base }}/servizi">Prenota la Prima Lettura</a><a class="btn btn-2" href="{{ base }}/calcolo-human-design">Calcola la tua carta gratis</a></div>
</div></section>
{% endblock %}

{% block scripts %}
<script>
(function(){
  var tema='tutti', q=''; var form=document.getElementById('bl-form');
  var carte=[].slice.call(document.querySelectorAll('#bl-griglia .bl-card'));
  var chips=[].slice.call(document.querySelectorAll('.bl-chip')), conta=document.getElementById('bl-conta'), vuoto=document.getElementById('bl-vuoto'), campo=document.getElementById('bl-q');
  function norm(t){ return (t||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,''); }
  function ok(el){
    var t = tema==='tutti' || (el.getAttribute('data-temi')||'').split(' ').indexOf(tema)>=0;
    var testo = norm(el.textContent);
    var s = !q || q.split(/\s+/).every(function(w){ var r = w.length>4 ? w.replace(/[aeio]$/,'') : w; return testo.indexOf(r)>=0; });
    return t && s;
  }
  function aggiorna(){
    var n=0; carte.forEach(function(c){ var v=ok(c); c.hidden=!v; c.style.display = v ? '' : 'none'; if(v) n++; });
    conta.textContent = n===carte.length ? carte.length+' articoli, dal più recente' : n+' di '+carte.length+' articoli';
    vuoto.hidden = n>0;
  }
  form.addEventListener('submit', function(ev){ ev.preventDefault(); q=norm(campo.value.trim()); aggiorna(); });
  campo.addEventListener('input', function(){ if(!campo.value.trim()){ q=''; aggiorna(); } });
  aggiorna();
})();
</script>
{% endblock %}
