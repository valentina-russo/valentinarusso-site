{# Barra di navigazione - veste "Meccanica Calda". Gli indirizzi restano quelli
   di Grav: nessun .html, nessun cambio di URL. #}
{% set corp = ('/aziende' in page.route) or (page.header.corporate is defined and page.header.corporate) %}
{% set base = grav.base_url %}
<a class="salta-al-contenuto" href="#contenuto">Vai al contenuto</a>
<nav class="nav"><div class="wrap">
  <a class="brand" href="{{ base }}/{{ corp ? 'aziende' : '' }}"><img class="logo" src="{{ theme_url }}/images/logo-quadro.png" alt="" width="40" height="40"><span>Valentina Russo<em>Consulente Human Design / BG5&reg;</em></span></a>
  <button class="apri-menu" id="apri-menu" type="button" aria-controls="pannello" aria-expanded="false" aria-label="Apri il menu"><span></span></button>
  <div class="pannello" id="pannello">
    {% if corp %}
    <ul class="menu">
      <li><a href="{{ base }}/aziende/bg5"{{ page.route == '/aziende/bg5' ? ' aria-current="page"' : '' }}>Cos&rsquo;&egrave; il BG5&reg;</a></li>
      <li><a href="{{ base }}/aziende"{{ page.route == '/aziende' ? ' aria-current="page"' : '' }}>Home</a></li>
      <li><a href="{{ base }}/aziende/servizi"{{ '/aziende/servizi' in page.route ? ' aria-current="page"' : '' }}>Servizi</a></li>
      <li><a href="{{ base }}/aziende/blog"{{ '/aziende/blog' in page.route ? ' aria-current="page"' : '' }}>Blog</a></li>
      <li><a href="{{ base }}/aziende/contatti"{{ '/aziende/contatti' in page.route ? ' aria-current="page"' : '' }}>Contatti</a></li>
      <li><a href="{{ base }}/">Privati</a></li>
    </ul>
    <a class="btn btn-1" href="{{ base }}/aziende/contatti">Parliamo del tuo team</a>
    {% else %}
    <ul class="menu">
      <li><a href="{{ base }}/human-design"{{ '/human-design' in page.route ? ' aria-current="page"' : '' }}>Cos&rsquo;&egrave; lo Human Design</a></li>
      <li><a href="{{ base }}/servizi"{{ '/servizi' in page.route ? ' aria-current="page"' : '' }}>Servizi</a></li>
      <li><a href="{{ base }}/blog"{{ '/blog' in page.route ? ' aria-current="page"' : '' }}>Blog</a></li>
      <li><a href="{{ base }}/chi-sono"{{ '/chi-sono' in page.route ? ' aria-current="page"' : '' }}>Chi Sono</a></li>
      <li><a href="{{ base }}/contatti"{{ '/contatti' in page.route ? ' aria-current="page"' : '' }}>Contatti</a></li>
      <li><a href="{{ base }}/aziende">Aziende</a></li>
    </ul>
    <a class="btn btn-1" href="{{ base }}/calcolo-human-design">Calcola la tua carta gratis</a>
    {% endif %}
  </div>
</div></nav>
