{# Pagina di errore del tema.
   Senza questo template il plugin "error" non trovava nulla da rendere e Grav
   rispondeva 500 su qualunque URL inesistente (llms-full.txt, link rotti,
   pagine cancellate). Ora un URL assente risponde 404 con una pagina vera. #}
{% extends 'partials/base.html.twig' %}

{% set codice = page.header.http_response_code|default(404) %}

{% block title %}Pagina non trovata | Valentina Russo{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/legali-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
<section class="err"><div class="wrap">
  <p class="etich">Errore {{ codice }}</p>
  <h1>Questa pagina non esiste</h1>
  <p class="err-testo">L&rsquo;indirizzo potrebbe essere cambiato o contenere un errore di battitura. Da qui puoi tornare alla home, calcolare la tua carta o leggere gli articoli.</p>
  <div class="azioni">
    <a class="btn btn-1" href="{{ base }}/">Torna alla home</a>
    <a class="btn btn-2" href="{{ base }}/calcolo-human-design">Calcola la tua carta Human Design</a>
    <a class="btn btn-2" href="{{ base }}/blog">Vai al blog</a>
  </div>
</div></section>
{% endblock %}
