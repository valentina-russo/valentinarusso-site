{% extends 'partials/base.html.twig' %}

{% set is_genera_carta = 'calcolo-human-design' in page.route or 'genera-carta' in page.route %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/legali-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
<header class="lg-testa"><div class="wrap">
  <p class="etich">{{ page.header.etichetta ?? page.title }}</p>
  <h1>{{ page.title }}</h1>
</div></header>
<div class="wrap lg-griglia">
  <aside class="lg-indice"><p class="etich">In questa pagina</p><nav id="lg-indice"></nav></aside>
  <div class="lg-corpo blog-article-body">{{ page.content|raw }}</div>
</div>
{% endblock %}

{% block scripts %}
<script>
/* indice della pagina costruito dai titoli del testo */
(function(){
  var corpo=document.querySelector('.lg-corpo'), nav=document.getElementById('lg-indice');
  if(!corpo||!nav) return;
  var titoli=corpo.querySelectorAll('h2');
  if(!titoli.length){ var col=document.querySelector('.lg-indice'); if(col) col.remove(); return; }
  titoli.forEach(function(h,i){
    if(!h.id) h.id='sez-'+(i+1);
    var a=document.createElement('a'); a.href='#'+h.id; a.textContent=h.textContent.trim(); nav.appendChild(a);
  });
})();
</script>
{% endblock %}
