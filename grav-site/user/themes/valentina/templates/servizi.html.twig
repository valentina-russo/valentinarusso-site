{% block extra_css %}
<style>
.letture-wrap { --primary-dark:#8B5E73; --accent-dark:#8A5A12; --navy:#1A2332; max-width:1000px; margin:0 auto; }
.letture-wrap h1.page-title { text-align:center; font-family:'Playfair Display',serif; font-size:clamp(1.75rem,4vw,2.75rem); font-weight:700; margin:1.75rem 0 1.25rem; color:var(--navy); }
.letture-wrap .hero-lead { text-align:center; font-family:'Playfair Display',serif; font-style:italic; font-size:1.2rem; color:var(--primary-color); max-width:720px; margin:0 auto 1.25rem; line-height:1.6; }
.letture-wrap .hero-body { text-align:center; max-width:700px; margin:0 auto 1.25rem; color:#2D2926; }
.letture-wrap .hero-cta { text-align:center; max-width:700px; margin:0 auto 2rem; color:var(--secondary-color); font-weight:700; }
.letture-wrap .section-title { text-align:center; font-family:'Playfair Display',serif; font-size:1.5rem; font-style:italic; margin:2.5rem 0 .35rem; color:var(--primary-dark); }
.letture-wrap .section-sub { text-align:center; color:#6B6560; font-size:1rem; max-width:580px; margin:0 auto 1.5rem; }
.letture-wrap .grid { display:grid; grid-template-columns:1fr; gap:1.5rem; }
@media (min-width:900px) {
  .letture-wrap .grid-singole { grid-template-columns:repeat(2,1fr); }
  .letture-wrap .grid-trio { grid-template-columns:repeat(3,1fr); }
}
@media (min-width:700px) {
  .letture-wrap .grid-cicli { grid-template-columns:repeat(2,1fr); }
}
.letture-wrap .card { background:var(--white); border:1px solid var(--soft-gray); border-top:4px solid var(--primary-color); border-radius:12px; padding:1.75rem; display:flex; flex-direction:column; overflow:hidden; }
.letture-wrap .card-img { width:calc(100% + 3.5rem); aspect-ratio:4/3; object-fit:cover; display:block; margin:-1.75rem -1.75rem 1.25rem; }
.letture-wrap .card.cycle { border-top-color:var(--secondary-color); }
.letture-wrap .card h3 { font-family:'Playfair Display',serif; font-size:1.3rem; margin:0 0 .75rem; font-style:italic; color:var(--navy); }
.letture-wrap .card p.desc { font-size:1rem; color:#2D2926; margin:0 0 1rem; }
.letture-wrap .card .per-chi { font-size:.9rem; color:#6B6560; background:var(--soft-gray); border-radius:6px; padding:.7rem .9rem; margin-bottom:1.25rem; }
.letture-wrap .card .per-chi strong { color:var(--navy); }
.letture-wrap .card .meta-row { display:flex; justify-content:space-between; align-items:baseline; margin-top:auto; padding-top:1rem; border-top:1px dashed var(--soft-gray); }
.letture-wrap .card .price { font-size:1.4rem; font-weight:700; color:var(--navy); }
.letture-wrap .card .duration { font-size:.8rem; color:#6B6560; }
.letture-wrap .card .price-flag { font-size:.7rem; color:var(--accent-dark); font-weight:700; display:block; margin-top:.15rem; }
.letture-wrap .btn-buy { display:block; text-align:center; margin-top:1rem; padding:.85rem 1rem; background:transparent; border:2px solid var(--primary-dark); color:var(--primary-dark); text-decoration:none; border-radius:6px; font-weight:700; font-size:1rem; transition:background .2s,color .2s; cursor:pointer; }
.letture-wrap .btn-buy:hover, .letture-wrap .btn-buy:focus-visible { background:var(--primary-dark); color:#fff; }
.letture-wrap .btn-buy:focus-visible { outline:2px solid var(--secondary-color); outline-offset:2px; }
.letture-wrap .btn-buy-primary { background:var(--accent-color); border-color:var(--accent-color); color:var(--navy); font-size:1.05rem; padding:1rem; box-shadow:0 4px 14px rgba(230,167,86,.35); }
.letture-wrap .btn-buy-primary:hover, .letture-wrap .btn-buy-primary:focus-visible { background:#d4933d; border-color:#d4933d; color:var(--navy); }
.letture-wrap .foundation-card { border-top-color:var(--accent-color); background:#FDF6EC; position:relative; }
.letture-wrap .foundation-card .price { font-size:1.6rem; }
.letture-wrap .start-badge { position:absolute; top:1rem; left:1rem; z-index:2; background:var(--accent-color); color:var(--navy); font-size:.75rem; font-weight:700; padding:.4rem .9rem; border-radius:100px; letter-spacing:.02em; box-shadow:0 2px 8px rgba(0,0,0,.15); }
</style>
{% endblock %}

{% block content %}
<main>
    <section class="section-padding">
        <div class="letture-wrap">

          <h1 class="page-title">Le Letture Human Design &amp; BG5&reg;</h1>
          <p class="hero-lead">Ogni lettura affonda su un&rsquo;area precisa del tuo Disegno: relazione, carriera, ciclo di vita, ombra.</p>
          <p class="hero-body">Nove percorsi indipendenti, costruiti sui tuoi dati di nascita reali attraverso lo Human Design e il sistema BG5&reg;. Scegli quello che risponde alla domanda che hai adesso.</p>
          <p class="hero-cta">Scegli la lettura, paga online, Valentina ti contatta per fissare data e ora.</p>

          <div style="margin-bottom: 2.5rem; text-align: center;" data-animate>
              <a href="{{ grav.base_url }}/human-design"
                 style="display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1.5rem; border: 1px solid rgba(182,131,151,0.35); border-radius: 50px; font-size: 0.85rem; font-weight: 600; color: var(--primary-color); text-decoration: none; background: rgba(182,131,151,0.05);">
                  <span style="font-size:1rem;">&#10022;</span>
                  Prima di tutto &mdash; Scopri cos&rsquo;&egrave; lo Human Design
                  <span>&rarr;</span>
              </a>
          </div>

          <h2 class="section-title">Letture Singole</h2>

          <div class="grid grid-singole">

            <div class="card foundation-card" id="foundation">
              <span class="start-badge">Si parte da qui</span>
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/foundation.jpg" alt="Valentina Russo durante una Lettura Foundation Human Design" loading="lazy">
              <h3>Lettura Foundation (Prima Lettura)</h3>
              <p class="desc">Decodifica la tua Tipologia Energetica, Strategia, Autorit&agrave; Interna e Profilo. Il punto di ingresso obbligato per tutte le altre letture.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chiunque non abbia ancora la propria mappa Human Design di base, prima di qualunque altra lettura.</div>
              <div class="meta-row">
                <div><span class="price">210&euro;</span><br><span class="duration">120 minuti</span></div>
              </div>
              <a class="btn-buy btn-buy-primary" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=foundation">Prenota e paga &rarr;</a>
            </div>

            <div class="card" id="coppia">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/coppia.jpg" alt="Due mani che si sfiorano su una tazza, simbolo della Lettura di Coppia" loading="lazy">
              <h3>Lettura di Coppia</h3>
              <p class="desc">Analizziamo il grafico di connessione tra i vostri due disegni: i canali elettromagnetici che vi tengono insieme, i centri che si definiscono a vicenda, il tema energetico della coppia. La compatibilit&agrave; si costruisce vivendo Strategia e Autorit&agrave; ogni giorno, la lettura mostra dove la vostra energia si amplifica naturalmente e dove invece oscilla tra caldo e freddo.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi in una relazione sente lo stesso conflitto tornare sempre uguale, o sta per fare un passo importante insieme (convivenza, matrimonio, un figlio).</div>
              <div class="meta-row">
                <div><span class="price">300&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=coppia">Prenota e paga &rarr;</a>
            </div>

          </div>

          <div class="grid grid-trio" style="margin-top: 1.5rem;">

            <div class="card" id="figlio">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/figlio.jpg" alt="Mano di un adulto che accompagna quella di un bambino, Lettura per il Figlio/a" loading="lazy">
              <h3>Lettura per il Figlio/a</h3>
              <p class="desc">Leggiamo il disegno di tuo figlio prima che il condizionamento si sedimenti, per capire dove &egrave; pi&ugrave; vulnerabile a imparare a ignorare la propria energia naturale. La lettura ti d&agrave; gli strumenti per non trasmettere questi schemi.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per genitori di bambini piccoli, quando il disegno naturale del figlio &egrave; ancora leggibile senza troppi strati di condizionamento sopra.</div>
              <div class="meta-row">
                <div><span class="price">210&euro;</span><br><span class="duration">60 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=figlio">Prenota e paga &rarr;</a>
            </div>

            <div class="card" id="ombra">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/ombra.jpg" alt="Ombra proiettata al tramonto, simbolo della Lettura dei Lati Ombra" loading="lazy">
              <h3>Lettura dei Lati Ombra</h3>
              <p class="desc">Ogni Tipologia ha una Firma, la sensazione di quando vivi allineato al tuo disegno, e un tema del Non-S&eacute;, il segnale di quando ne sei uscito. Mappiamo il tuo tema del Non-S&eacute; specifico e costruiamo un sistema di riconoscimento in tempo reale.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi ha gi&agrave; fatto la Prima Lettura ma continua a cadere nello stesso schema senza riuscire a intercettarlo in tempo.</div>
              <div class="meta-row">
                <div><span class="price">250&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=ombra">Prenota e paga &rarr;</a>
            </div>

            <div class="card" id="croce">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/croce.jpg" alt="Libro illuminato dal sole, simbolo della Lettura della Croce di Incarnazione" loading="lazy">
              <h3>Lettura della Croce di Incarnazione</h3>
              <p class="desc">La tua Croce di Incarnazione nasce da quattro porte, Sole e Terra coscienti e inconsci, e rappresenta circa il 70% della tua impronta energetica. La lettura ti mostra qual &egrave; la tua e cosa sei venuto a incarnare, non a fare.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi si chiede quale sia il proprio scopo pi&ugrave; ampio, oltre il lavoro di tutti i giorni.</div>
              <div class="meta-row">
                <div><span class="price">250&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=croce">Prenota e paga &rarr;</a>
            </div>

          </div>

          <h2 class="section-title">Cicli di Vita</h2>
          <p class="section-sub">Transiti astrologici classici, letti con la meccanica dello Human Design &mdash; un approfondimento avanzato, non il nucleo originario.</p>

          <div class="grid grid-cicli">

            <div class="card cycle" id="ritorno-solare">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/ritorno-solare.jpg" alt="Luce solare tra le foglie, simbolo del Ritorno Solare" loading="lazy">
              <h3>Lettura del Ritorno Solare</h3>
              <p class="desc">Ogni anno, vicino al tuo compleanno, il Sole transita di nuovo sulla porta esatta in cui si trovava alla tua nascita. La lettura individua quali porte si accendono nei prossimi dodici mesi.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi ha gi&agrave; la Prima Lettura e vuole un check-in annuale vicino al proprio compleanno.</div>
              <div class="meta-row">
                <div><span class="price">150&euro;</span><br><span class="duration">60 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=ritorno-solare">Prenota e paga &rarr;</a>
            </div>

            <div class="card cycle" id="ritorno-saturno">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/ritorno-saturno.jpg" alt="Clessidra antica su una mensola, simbolo del Ritorno di Saturno" loading="lazy">
              <h3>Lettura del Ritorno di Saturno</h3>
              <p class="desc">Intorno ai 29 anni il Ritorno di Saturno segna il passaggio alla piena responsabilit&agrave; della vita adulta. Calcoliamo il tuo grafico nel momento esatto del transito e lo confrontiamo con quello di nascita.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi si avvicina ai 29-30 anni e sente il peso di doversi prendere la responsabilit&agrave; della propria vita.</div>
              <div class="meta-row">
                <div><span class="price">250&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=ritorno-saturno">Prenota e paga &rarr;</a>
            </div>

            <div class="card cycle" id="ritorno-chirone">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/ritorno-chirone.jpg" alt="Ciotola riparata con oro kintsugi, simbolo del Ritorno di Chirone" loading="lazy">
              <h3>Lettura del Ritorno di Chirone</h3>
              <p class="desc">Intorno ai 50 anni il Ritorno di Chirone porta a galla la ferita che porti fin dall&rsquo;infanzia. La lettura ti mostra come quella ferita pu&ograve; diventare il contributo pi&ugrave; grande che hai da offrire.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi si avvicina ai 50 anni e sente riaffiorare una ferita di vecchia data.</div>
              <div class="meta-row">
                <div><span class="price">250&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=ritorno-chirone">Prenota e paga &rarr;</a>
            </div>

            <div class="card cycle" id="opposizione-urano">
              <img class="card-img" src="{{ grav.base_url }}/letture-dati/img/opposizione-urano.jpg" alt="Muta di pelle di serpente, simbolo dell'Opposizione di Urano" loading="lazy">
              <h3>Lettura dell&rsquo;Opposizione di Urano</h3>
              <p class="desc">Tra i 38 e i 42 anni l&rsquo;Opposizione di Urano segna lo spostamento dal tema del Nodo Sud al tema del Nodo Nord: la fase che prepara la fioritura dei tuoi doni.</p>
              <div class="per-chi"><strong>Per chi &egrave;:</strong> per chi ha tra i 38 e i 42 anni e sente che la vita costruita finora non basta pi&ugrave;.</div>
              <div class="meta-row">
                <div><span class="price">250&euro;</span><br><span class="duration">90 minuti</span></div>
              </div>
              <a class="btn-buy" href="{{ grav.base_url }}/letture-dati/checkout.php?reading=opposizione-urano">Prenota e paga &rarr;</a>
            </div>

          </div>

        </div>
    </section>
</main>
{% endblock %}
