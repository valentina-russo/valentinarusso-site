{% extends 'partials/base.html.twig' %}

{% block title %}{{ page.title }} | Valentina Russo{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/contatti-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
<section class="hero ct-hero"><div class="wrap">
  <div class="rivela">
    <p class="etich">Contatti</p>
    <h1>Iniziamo una conversazione</h1>
    <p class="sotto">Preferisci un contatto diretto?</p>
    <ul class="ct-diretti">
      <li><a href="mailto:consulenza@valentinarussobg5.com"><span class="ct-ico">&#9993;</span><span><b>Email</b><br>consulenza@valentinarussobg5.com</span></a></li>
      <li><a href="https://wa.me/393791037653"><span class="ct-ico">&#9742;</span><span><b>Whatsapp</b><br>+39 379 103 7653</span></a></li>
      <li><a href="https://www.instagram.com/valentinarussobg5/" target="_blank" rel="noopener"><span class="ct-ico">&#9737;</span><span><b>Instagram</b><br>@valentinarussobg5</span></a></li>
    </ul>
  </div>
  <form class="card ct-form rivela" action="#" method="post" onsubmit="return false" novalidate>
    <div class="campo"><label for="c-nome">Nome Completo</label><input id="c-nome" name="nome" type="text" autocomplete="name"></div><div class="campo"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email"></div><div class="campo"><label for="c-messaggio">Messaggio / Tipo di Consulenza</label><textarea id="c-messaggio" name="messaggio" rows="6"></textarea></div>
    <label class="consenso"><input type="checkbox" name="privacy" required> <span>Ho letto l&rsquo;<a href="{{ base }}/privacy">informativa privacy</a> e acconsento al trattamento dei dati per rispondere alla mia richiesta.</span></label>
    <button class="btn btn-1" type="submit">Invia Messaggio</button>
    <p class="ct-nota">Rispondo di persona, di solito entro due giorni lavorativi.</p>
  </form>
</div></section>
{% endblock %}

{% block scripts %}
<script>
(function(){
  var els=[].slice.call(document.querySelectorAll('.rivela'));
  if(!('IntersectionObserver' in window)||(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches)){ els.forEach(function(e){e.classList.add('in-vista')}); return; }
  var io=new IntersectionObserver(function(en){ en.forEach(function(x){ if(x.isIntersecting){ x.target.classList.add('in-vista'); io.unobserve(x.target); } }); },{threshold:.12});
  els.forEach(function(e){io.observe(e)});
})();
</script>
{% endblock %}
