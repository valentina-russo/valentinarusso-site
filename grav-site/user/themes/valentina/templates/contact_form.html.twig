{% extends 'partials/base.html.twig' %}

{% block title %}{{ page.title }} | Valentina Russo{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/contatti-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
{% set az = page.header.corporate is defined and page.header.corporate %}
<section class="hero ct-hero"><div class="wrap">
  <div class="rivela">
    <p class="etich">{{ az ? 'Aziende' : 'Contatti' }}</p>
    <h1>{{ page.title }}</h1>
    <p class="sotto">{{ az
      ? 'Compila il form per richiedere un contatto conoscitivo e valutare le soluzioni BG5&reg; per il tuo business.'
      : 'Preferisci un contatto diretto?' }}</p>
    {% if az %}<p class="ct-diretto">Preferisci un contatto diretto?</p>{% endif %}
    <ul class="ct-diretti">
      <li><a href="mailto:consulenza@valentinarussobg5.com"><span class="ct-ico">&#9993;</span><span><b>Email</b><br>consulenza@valentinarussobg5.com</span></a></li>
      <li><a href="https://wa.me/393791037653"><span class="ct-ico">&#9742;</span><span><b>Whatsapp</b><br>+39 379 103 7653</span></a></li>
      <li><a href="https://www.instagram.com/valentinarussobg5/" target="_blank" rel="noopener"><span class="ct-ico">&#9737;</span><span><b>Instagram</b><br>@valentinarussobg5</span></a></li>
    </ul>
  </div>

  {# il modulo e' quello vero di Grav: cambia campi e destinatario per pagina #}
  <div class="card ct-form rivela">
    {% set the_form = forms(page.header.form.name ?? page.slug) %}
    {% if the_form %}
      {% include "forms/form.html.twig" with {form: the_form} %}
    {% else %}
      <p class="ct-nota">Il modulo non &egrave; disponibile in questo momento. Scrivimi a <a href="mailto:consulenza@valentinarussobg5.com">consulenza@valentinarussobg5.com</a>.</p>
    {% endif %}
    <p class="ct-nota">Rispondo di persona, di solito entro due giorni lavorativi.</p>
  </div>
</div></section>
{% endblock %}
