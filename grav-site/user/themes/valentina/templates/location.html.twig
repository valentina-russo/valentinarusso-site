{% extends 'partials/base.html.twig' %}

{% set city = page.header.city ?? 'Italia' %}
{% set region = page.header.region ?? 'Italia' %}


{% block schema %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "ProfessionalService"],
  "name": "Valentina Russo — Consulente BG5® e Human Design",
  "url": "{{ grav.base_url_absolute }}",
  "image": "{{ grav.base_url_absolute }}/user/pages/assets/valentina.jpg",
  "description": "{{ page.header.seo_desc|e('js') }}",
  "priceRange": "€€",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "{{ city }}",
    "addressRegion": "{{ region }}",
    "addressCountry": "IT"
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "{{ region }}" },
    { "@type": "Country", "name": "Italia" }
  ],
  "knowsAbout": ["BG5 System", "Human Design", "Career Consulting", "Business Strategy"],
  "hasCredential": {
    "@type": "EducationalOccupationalCredential",
    "name": "BG5® Business Institute Certified",
    "credentialCategory": "Professional Certification",
    "url": "https://www.humandesignbusiness.com/"
  },
  "sameAs": [
    "https://www.instagram.com/valentinarussobg5/",
    "https://www.humandesignbusiness.com/"
  ],
  "serviceType": ["BG5 Consulting", "Human Design Analysis", "Career Consulting", "Business Consulting"]
}
</script>
{% endblock %}

{% block extra_css %}
{% include 'partials/calc-stile.html.twig' %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/citta-d2.css?v={{ theme_version }}">
<link rel="stylesheet" href="{{ theme_url }}/css/d2/calcolo-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
<section class="hero ci-hero"><div class="wrap">
  <div class="rivela">
    <p class="etich">BG5&reg; Certified Consultant</p>
    <h1>{{ page.title }}</h1>
    <p class="sotto">{{ page.header.subtitle ?? 'Consulenze individuali BG5® e Human Design per carriera, relazioni e business.' }}</p>
    <div class="azioni"><a class="btn btn-1" href="#carta-calculator">Calcola la tua Carta &rarr;</a><a class="btn btn-2" href="{{ base }}/contatti">Contattami ora</a></div>
  </div>
  <figure class="foto rivela"><img src="{{ base }}/user/pages/assets/valentina.jpg" alt="Valentina Russo, Consulente BG5&reg; e Human Design" width="800" height="1000"></figure>
</div></section>

<section class="ci-testo"><div class="wrap">
  <div class="ci-prosa rivela">{{ page.content|raw }}</div>
</div></section>

<section class="sez-alt ci-offerte"><div class="wrap">
  <div class="rivela ci-centro"><p class="etich">Consulenze</p><h2>Consulenze disponibili</h2><p class="sotto">Sessioni online &mdash; accessibili da {{ city }} e da tutta Italia</p></div>
  <div class="griglia">
    <div class="card ci-off rivela"><h3>Prima Lettura Human Design</h3><p>Sessione di 2 ore. Tipo Energetico, Strategia, Autorit&agrave; Decisionale. La mappa del tuo funzionamento naturale.</p><p class="ci-prezzo">210 &euro;</p></div>
    <div class="card ci-off rivela"><h3>Panoramica BG5&reg; Carriera</h3><p>90 minuti. Disegno di Carriera, Tipo di Carriera, Strategia e Autorit&agrave; in chiave professionale. Certificato BG5&reg;.</p><p class="ci-prezzo">350 &euro;</p></div>
    <div class="card ci-off rivela"><h3>Percorso BG5&reg; Business Blueprint</h3><p>15 sessioni per professionisti indipendenti e imprenditori. Strategia, posizionamento, partnership.</p><p class="ci-prezzo">1.800 &euro;</p></div>
  </div>
</div></section>

<section class="sez-alt ci-diff"><div class="wrap rivela">
  <p class="etich">Human Design e BG5&reg;</p>
  <h2>Human Design e BG5: qual &egrave; la differenza?</h2>
  <p class="ci-diff-testo">Stesso sistema, stesso bodygraph, angolazione diversa. Human Design guarda la persona nella sua interezza; BG5 applica gli stessi strumenti al lavoro, alla carriera e ai team.</p>
  <p class="ci-diff-testo">La carta &egrave; la stessa. Cambia la lente con cui viene letta. Una sessione BG5 non sostituisce un percorso di crescita personale con HD &mdash; sono due applicazioni complementari dello stesso sistema.</p>
  <p class="ci-diff-link"><a class="lnk" href="{{ base }}/human-design">Cos&rsquo;&egrave; lo Human Design &rarr;</a><a class="lnk" href="{{ base }}/aziende/bg5">Cos&rsquo;&egrave; il BG5&reg; &rarr;</a></p>
</div></section>

<section class="ci-calc"><div class="wrap">
  {% include 'partials/calc-singolo.html.twig' %}
  {% include 'partials/seo-calcolatore.html.twig' %}
</div></section>

<section class="ci-bio"><div class="wrap"><div class="card ci-scheda rivela">
  <img src="{{ base }}/user/pages/assets/valentina.jpg" alt="Valentina Russo, Consulente BG5&reg; e Human Design" width="120" height="120">
  <div>
    <h3>Valentina Russo</h3>
    <p>BG5&reg; Business Institute Certified Consultant &middot; Human Design Analyst &middot; Guida Mentale 2/4</p>
    <p>Consulente certificata BG5&reg; con clienti in tutta Italia. Le sessioni si svolgono online in videochiamata &mdash; stessa qualit&agrave; e profondit&agrave; di una consulenza in presenza.</p>
  </div>
</div></div></section>

<section class="fine"><div class="wrap rivela">
  <h2>Pronto a partire?</h2>
  <p>Scrivi da {{ city }} o da qualsiasi citt&agrave; italiana &mdash; rispondo entro 24 ore e concordiamo il primo appuntamento.</p>
  <div class="azioni"><a class="btn btn-1" href="{{ base }}/contatti">Contattami ora</a><a class="btn btn-2" href="{{ base }}/calcolo-human-design">Calcola la tua carta gratis</a></div>
</div></section>
{% endblock %}
