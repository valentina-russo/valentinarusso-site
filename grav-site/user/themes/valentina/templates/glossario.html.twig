{% extends 'partials/base.html.twig' %}

{% block schema %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ (page.header.seo_title ?? page.title)|json_encode|raw }},
  "description": {{ (page.header.seo_desc ?? page.header.description)|json_encode|raw }},
  "inLanguage": "it",
  "datePublished": "{{ page.date|date('c') }}",
  "dateModified": "{{ page.modified|date('c') }}",
  "author": { "@type": "Person", "@id": "{{ grav.base_url_absolute }}/#valentina-russo" },
  "publisher": { "@type": "Organization", "@id": "{{ grav.base_url_absolute }}/#organization" },
  "mainEntityOfPage": "{{ page.url(true) }}",
  "isPartOf": { "@type": "WebPage", "url": "{{ page.parent.url(true) }}" }
}
</script>
{% if page.header.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in page.header.faq %}
    { "@type": "Question", "name": {{ (f.question ?? f.q)|json_encode|raw }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ (f.answer ?? f.a)|json_encode|raw }} } }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Cos&rsquo;è lo Human Design", "item": "{{ grav.base_url_absolute }}/human-design" }{% if page.parent.route != '/human-design' %},
    { "@type": "ListItem", "position": 2, "name": {{ page.parent.title|json_encode|raw }}, "item": "{{ page.parent.url(true) }}" },
    { "@type": "ListItem", "position": 3, "name": {{ page.title|json_encode|raw }}, "item": "{{ page.url(true) }}" }{% else %},
    { "@type": "ListItem", "position": 2, "name": {{ page.title|json_encode|raw }}, "item": "{{ page.url(true) }}" }{% endif %}
  ]
}
</script>
{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/glossario-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
{% set img = page.media|length ? page.media|first : null %}
{% set fratelli = page.parent.children.published %}
{% set barra = page.parent.route != '/human-design' and fratelli.count > 1 %}

{% if barra %}
<nav class="gl-barra" aria-label="{{ page.parent.title }}"><div class="wrap">
  {% for c in fratelli.order('header.ordine','asc') %}<a href="{{ c.url }}"{% if c.route == page.route %} aria-current="page"{% endif %}>{{ c.header.nome_breve ?? c.title }}</a>{% endfor %}
</div></nav>
<script>(function(){var b=document.querySelector('.gl-barra .wrap');if(!b)return;var n=b.parentNode,a=b.querySelector('[aria-current]');function stato(){n.classList.toggle('scorre-sx',b.scrollLeft>4);n.classList.toggle('scorre-dx',b.scrollLeft+b.clientWidth<b.scrollWidth-4);}if(a&&b.scrollWidth>b.clientWidth)b.scrollLeft=a.offsetLeft-(b.clientWidth-a.offsetWidth)/2;stato();b.addEventListener('scroll',stato,{passive:true});addEventListener('resize',stato);})();</script>
{% endif %}

<header class="hero gl-testa{% if img %} gl-testa-due{% endif %}"><div class="wrap">
  <div class="rivela">
    <nav class="gl-briciole"><a href="{{ base }}/human-design">Cos&rsquo;&egrave; lo Human Design</a>{% if page.parent.route != '/human-design' %} <span>&rsaquo;</span> <a href="{{ page.parent.url }}">{{ page.parent.title }}</a>{% endif %}</nav>
    <h1>{{ page.title }}</h1>
    {% if page.header.description %}<p class="sotto">{{ page.header.description }}</p>{% endif %}
  </div>
  {% if img %}
  <figure class="gl-disegno rivela"><img src="{{ img.cropResize(760,1170).url }}" alt="{{ page.header.alt_immagine ?? page.title }}" style="aspect-ratio:{{ img.width ?: 1 }}/{{ img.height ?: 1 }}">{% if page.header.didascalia %}<figcaption>{{ page.header.didascalia }}</figcaption>{% endif %}</figure>
  {% endif %}
</div></header>

{% if page.header.scheda %}
<section class="gl-dati"><dl class="wrap">
  {% for v in page.header.scheda %}
  <div><dt>{{ v.etichetta }}</dt><dd>{{ v.valore }}{% if v.nota %}<small>{{ v.nota }}</small>{% endif %}</dd></div>
  {% endfor %}
</dl></section>
{% endif %}

{% if page.header.apertura %}
<section class="gl-apertura"><div class="wrap rivela blog-article-body">{{ page.header.apertura|markdown }}</div></section>
{% endif %}

{% if page.header.definito and page.header.aperto %}
<section class="gl-facce"><div class="wrap">
  <article class="gl-faccia rivela">
    <span class="etich"><i class="gl-segno"></i> {{ page.header.definito.etichetta ?? 'Se ce l&rsquo;hai definito'|raw }}</span>
    <h2>{{ page.header.definito.titolo }}</h2>
    <div class="blog-article-body">{{ page.header.definito.testo|markdown }}</div>
  </article>
  <article class="gl-faccia gl-aperta rivela">
    <span class="etich"><i class="gl-segno"></i> {{ page.header.aperto.etichetta ?? 'Se ce l&rsquo;hai bianco'|raw }}</span>
    <h2>{{ page.header.aperto.titolo }}</h2>
    <div class="blog-article-body">{{ page.header.aperto.testo|markdown }}</div>
  </article>
</div></section>
{% endif %}

<section class="gl-corpo"><div class="wrap">
  {% if page.content|trim %}<div class="gl-prosa blog-article-body rivela">{{ page.content|raw }}</div>{% endif %}
  {% if page.header.richiamo %}
  <aside class="gl-richiamo rivela"><p>{{ page.header.richiamo|raw }}</p></aside>
  {% endif %}
</div></section>

{% if page.header.faq %}
<section class="gl-faq"><div class="wrap rivela">
  <h2>Domande frequenti</h2>
  {% for d in page.header.faq %}
  <details{% if loop.first %} open{% endif %}><summary>{{ d.question }}</summary><p>{{ d.answer }}</p></details>
  {% endfor %}
</div></section>
{% endif %}

{% if page.children.published.count %}
<section class="sez-alt gl-figlie"><div class="wrap">
  <div class="rivela ci-centro"><p class="etich">{{ page.header.etichetta_figlie ?? 'In questa guida' }}</p><h2>{{ page.header.titolo_figlie ?? 'Le voci' }}</h2></div>
  <div class="griglia">
    {% for c in page.children.published.order('header.ordine','asc') %}
    <a class="card gl-voce rivela" href="{{ c.url }}"><h3>{{ c.title }}</h3>{% if c.header.description %}<p>{{ c.header.description }}</p>{% endif %}<span class="lnk">Leggi &rarr;</span></a>
    {% endfor %}
  </div>
</div></section>
{% endif %}

{% if not barra and page.parent.children.published.count > 1 and page.parent.route != '/' %}
<section class="gl-sorelle"><div class="wrap rivela">
  <p class="etich">Continua</p>
  <p class="gl-righe">{% for c in page.parent.children.published %}{% if c.route != page.route %}<a href="{{ c.url }}">{{ c.title }}</a>{% endif %}{% endfor %}</p>
</div></section>
{% endif %}

<section class="fine"><div class="wrap rivela">
  <h2>{{ page.header.chiusa_titolo ?? 'Vuoi capire come funziona nel tuo caso?' }}</h2>
  <p>{{ page.header.chiusa_testo ?? 'La Prima Lettura parte dalla tua carta reale: 90 minuti sul tuo Tipo, la tua Strategia e la tua Autorit&agrave;, con quello che cambia nella pratica.' }}</p>
  <div class="azioni"><a class="btn btn-1" href="{{ base }}/servizi#singole">Prenota la Prima Lettura</a><a class="btn btn-2" href="{{ base }}/libretto-istruzioni">Il Libretto d&rsquo;Istruzioni</a></div>
</div></section>
{% endblock %}
