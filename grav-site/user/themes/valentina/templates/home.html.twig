{% extends 'partials/base.html.twig' %}

{% block title %}Valentina Russo | Consulente BG5&reg; &amp; Human Design{% endblock %}
{% block og_title %}Valentina Russo | Consulente BG5® & Human Design{% endblock %}
{% block og_description %}Consulente BG5® certificata e Human Design Analyst. Scopri il tuo tipo energetico, carriera e relazioni. Consulenze individuali e per aziende.{% endblock %}

{% block schema %}
{{ parent() }}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "{{ grav.base_url_absolute }}/#webpage",
  "url": "{{ grav.base_url_absolute }}/",
  "name": "Valentina Russo | Consulente BG5® & Human Design",
  "description": "Consulente BG5® e Human Design per carriera, relazioni e amor proprio. Analisi del tuo tipo energetico, strategia e autorità interna.",
  "inLanguage": "it",
  "datePublished": "2024-01-01",
  "dateModified": "{{ page.modified|date('c') }}",
  "isPartOf": {
    "@type": "WebSite",
    "url": "{{ grav.base_url_absolute }}"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ grav.base_url_absolute }}/"
      }
    ]
  }
}
</script>
{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/hero-privati.css?v=20260311">
{% endblock %}

{% block content %}
<main>
    <!-- NEW HERO V2 -->
    <section class="hero-v2">
      <div class="hero-text">
        <p class="eyebrow">A mete eccelse, per anguste vie</p>
        <h1 class="headline">
          Ri-conosci<br>
          e <em>ama</em><br>
          te stesso
        </h1>
        <p class="subline">
          Valentina Russo &mdash; Guida Mentale 2/4<br>
          Ti aiuto a leggere chi sei davvero attraverso la logica della tua energia.
        </p>
        <div class="cta-group">
          <a href="{{ grav.base_url }}/servizi#percorso" class="btn-primary-v2">Inizia il tuo viaggio &rarr;</a>
          <a href="{{ grav.base_url }}/calcolo-human-design" class="btn-secondary-v2">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polygon points="10 8 16 12 10 16 10 8" />
            </svg>
            <span style="font-size:.78rem;">Calcolo Human Design gratuito</span>
          </a>
        </div>
        <p style="margin-top: 1rem; font-size: 0.8rem; color: #aaa;">
          Nuovo qui? &rarr; <a href="{{ grav.base_url }}/human-design" style="color: var(--primary-color, #B68397); text-decoration: none; font-weight: 600;">Scopri cos&rsquo;&egrave; lo Human Design</a>
        </p>
        <div class="social-proof">
