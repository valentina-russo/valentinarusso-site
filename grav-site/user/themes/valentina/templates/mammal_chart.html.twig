{% extends 'partials/base.html.twig' %}

{% block title %}{{ page.header.seo_title ?? page.title }}{% endblock %}

{% block content %}
<style>
  .mc-wrap{max-width:820px;margin:0 auto;padding:2rem 1.25rem 4rem;font-family:var(--font-body,inherit);}
  .mc-wrap h1{font-family:var(--font-serif,'Playfair Display',serif);font-size:2rem;margin-bottom:.5rem;}
  .mc-tagline{color:#666;margin-bottom:1.5rem;}
  .mc-notice{background:#FFF4E5;border:1px solid #E8A33D;border-radius:8px;padding:14px 18px;margin:0 0 1.5rem;font-size:.92rem;}
  .mc-form{display:grid;gap:.9rem;background:#F7F5F2;border-radius:12px;padding:1.5rem;margin-bottom:2rem;}
  .mc-form label{display:block;font-size:.85rem;font-weight:600;margin-bottom:.3rem;}
  .mc-form input,.mc-form select{width:100%;padding:.6rem .75rem;border:1px solid #ccc;border-radius:6px;font-size:1rem;box-sizing:border-box;}
  .mc-form-row{display:grid;grid-template-columns:1fr 1fr;gap:.9rem;}
  .mc-btn{background:#1A2332;color:#fff;border:none;border-radius:8px;padding:.85rem 1.5rem;font-size:1rem;cursor:pointer;font-weight:600;}
  .mc-btn:hover{opacity:.9;}
  .mc-btn:disabled{opacity:.5;cursor:not-allowed;}
  .mc-error{color:#B02020;font-size:.88rem;margin-top:.3rem;display:none;}
  .mc-results{display:none;}
  .mc-autocomplete-wrap{position:relative;}
  .mc-autocomplete-list{position:absolute;top:calc(100% + 2px);left:0;right:0;background:#fff;border:1.5px solid #1A2332;border-radius:8px;box-shadow:0 6px 20px rgba(0,0,0,.12);z-index:200;max-height:220px;overflow-y:auto;display:none;margin:0;padding:0;}
  .mc-autocomplete-list li{padding:.6rem .85rem;cursor:pointer;font-size:.9rem;color:#333;border-bottom:1px solid #f5f2ef;list-style:none;}
  .mc-autocomplete-list li:last-child{border-bottom:none;}
  .mc-autocomplete-list li:hover{background:#f8f4ff;}
  .mc-tz-detected{font-size:.75rem;color:#7c5cbf;margin-top:.25rem;display:none;}
  .mc-hint{font-size:.75rem;color:#888;margin-top:.25rem;}
  .mc-svg-wrap{background:#fff;border:1px solid #E2DED8;border-radius:12px;padding:1rem;margin-bottom:1.5rem;overflow-x:auto;}
  .mc-svg-wrap svg{display:block;margin:0 auto;max-width:100%;height:auto;}
  .mc-group{border:1px solid #E2DED8;border-radius:10px;padding:1.1rem 1.25rem;margin-bottom:1rem;}
  .mc-group h3{margin:0 0 .5rem;font-size:1.1rem;}
  .mc-group .mc-portal{font-size:.8rem;color:#A8722E;font-weight:600;text-transform:uppercase;letter-spacing:.03em;}
  .mc-gate-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:.3rem;padding:.5rem 0;border-bottom:1px solid #F0EDE8;font-size:.92rem;}
  .mc-gate-row:last-child{border-bottom:none;}
  .mc-gate-row.active{font-weight:600;color:#1A2332;}
  .mc-gate-row.inactive{color:#AAA;}
  .mc-badge{display:inline-block;font-size:.72rem;padding:.15rem .5rem;border-radius:4px;background:#1A2332;color:#fff;margin:.15rem 0 .15rem .4rem;}
  .mc-badge.design{background:#8B2C2C;}
  .mc-summary{background:#1A2332;color:#fff;border-radius:10px;padding:1.25rem 1.5rem;margin-bottom:1.5rem;}
  .mc-summary h2{margin:0 0 .5rem;font-size:1.3rem;font-family:var(--font-serif,'Playfair Display',serif);}
  .mc-channels{font-size:.9rem;color:#EEE;margin:0;}
</style>

<div class="mc-wrap">
  <h1>{{ page.header.title }}</h1>
  <p class="mc-tagline">{{ page.header.description ?? 'La Mammal Chart del tuo cane: matrice a 15 porte, non la carta umana.' }}</p>
  <div class="mc-notice">
    ⚠️ <strong>Beta.</strong> Il calcolo usa la matrice mammifera corretta (15 porte, offset Design lunare) come descritta nel materiale originale di Ra Uru Hu. Le interpretazioni testuali estese sono in fase di revisione con Valentina.
  </div>

  <div class="mc-form" id="mc-form">
    <div>
      <label for="mc-name">Nome del cane (opzionale)</label>
      <input type="text" id="mc-name" placeholder="Es. Argo">
    </div>
    <div class="mc-form-row">
      <div>
        <label for="mc-date">Data di nascita (o adozione)</label>
        <input type="date" id="mc-date">
      </div>
      <div>
        <label for="mc-time">Ora (se sconosciuta, lascia 12:00)</label>
        <input type="time" id="mc-time" value="12:00">
      </div>
    </div>
    <div>
      <label for="mc-city">📍 Luogo di nascita</label>
      <div class="mc-autocomplete-wrap">
        <input type="text" id="mc-city" placeholder="Es: Milano, Roma, Napoli…" autocomplete="off">
        <ul class="mc-autocomplete-list" id="mc-city-list"></ul>
      </div>
      <div class="mc-hint">Inserisci la città, il fuso orario viene rilevato automaticamente.</div>
      <select id="mc-tz" style="margin-top:.5rem;">
        <option value="Europe/Rome" selected>Italia (Europe/Rome)</option>
        <option value="Europe/London">Regno Unito</option>
        <option value="Europe/Paris">Francia / Belgio</option>
        <option value="Europe/Berlin">Germania / Austria</option>
        <option value="Europe/Madrid">Spagna</option>
        <option value="Europe/Zurich">Svizzera</option>
        <option value="America/New_York">USA Est</option>
        <option value="America/Chicago">USA Centrale</option>
        <option value="America/Los_Angeles">USA Ovest</option>
        <option value="America/Argentina/Buenos_Aires">Argentina</option>
        <option value="America/Sao_Paulo">Brasile</option>
        <option value="Asia/Dubai">Emirati Arabi</option>
        <option value="Asia/Kolkata">India</option>
        <option value="Asia/Tokyo">Giappone</option>
        <option value="Australia/Sydney">Australia</option>
      </select>
      <div class="mc-tz-detected" id="mc-tz-detected"></div>
    </div>
    <div id="mc-error" class="mc-error"></div>
    <button class="mc-btn" id="mc-calc-btn">Calcola la Mammal Chart</button>
  </div>

  <div class="mc-results" id="mc-results"></div>
</div>

<script src="/user/themes/valentina/js/swe-hd.js"></script>
<script>
// ─── City autocomplete (identico al calcolatore umano) ─────────────────────
function initCityAutocomplete(cityInputId,cityListId,tzSelectId,tzDetectedId){
  const cityInput=document.getElementById(cityInputId),cityList=document.getElementById(cityListId),tzSelect=document.getElementById(tzSelectId),tzDetected=document.getElementById(tzDetectedId);
  if(!cityInput||!cityList||!tzSelect)return;
  let debounce=null;
  cityInput.addEventListener('input',()=>{clearTimeout(debounce);const q=cityInput.value.trim();if(q.length<3){cityList.style.display='none';return;}debounce=setTimeout(()=>fetchCities(q),350);});
  cityInput.addEventListener('blur',()=>{setTimeout(()=>{cityList.style.display='none';},200);});
  async function fetchCities(q){try{const url=`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(q)}&format=json&limit=6&addressdetails=1&featuretype=city`;const res=await fetch(url,{headers:{'Accept-Language':'it'}});const data=await res.json();showSuggestions(data);}catch(e){cityList.style.display='none';}}
  function showSuggestions(places){cityList.innerHTML='';if(!places.length){cityList.style.display='none';return;}places.forEach(p=>{const li=document.createElement('li');const parts=[p.display_name.split(',')[0].trim()];if(p.address){if(p.address.state)parts.push(p.address.state);if(p.address.country)parts.push(p.address.country);}li.textContent=parts.join(', ');li.addEventListener('click',()=>selectCity(p,li.textContent));cityList.appendChild(li);});cityList.style.display='block';}
  async function selectCity(place,label){cityInput.value=label;cityList.style.display='none';const lat=parseFloat(place.lat),lng=parseFloat(place.lon);try{const tzRes=await fetch(`https://timeapi.io/api/timezone/coordinate?latitude=${lat}&longitude=${lng}`);const tzData=await tzRes.json();const tz=tzData.timeZone;if(tz){let found=false;for(const opt of tzSelect.options){if(opt.value===tz){tzSelect.value=tz;found=true;break;}}if(!found){const opt=document.createElement('option');opt.value=tz;opt.textContent=tz;tzSelect.appendChild(opt);tzSelect.value=tz;}if(tzDetected){tzDetected.textContent=`✓ Fuso orario rilevato: ${tz}`;tzDetected.style.display='block';}}}catch(e){}}
}

// ─── Swiss Ephemeris init (identico al calcolatore umano) ──────────────────
let _sweMod=null,_sweCalc=null,_sweJulday=null;
async function initSwe(){
  if(_sweMod)return;
  const SweClass=window.SwissEphemeris;
  if(!SweClass)throw new Error('SwissEphemeris non caricato');
  const inst=new SweClass();await inst.init();
  try{await inst.loadStandardEphemeris();}catch(e){}
  _sweMod=inst.module;
  try{
    const CDN='https://cdn.jsdelivr.net/gh/aloistr/swisseph/ephe';
    try{_sweMod.FS.mkdir('/ephe');}catch(e){}
    const files=['sepl_18.se1','semo_18.se1'];
    await Promise.all(files.map(async f=>{const resp=await fetch(`${CDN}/${f}`);if(resp.ok)_sweMod.FS.writeFile(`/ephe/${f}`,new Uint8Array(await resp.arrayBuffer()));}));
    _sweMod.cwrap('swe_set_ephe_path_wrap',null,['string'])('/ephe');
  }catch(e){_sweMod.cwrap('swe_set_ephe_path_wrap',null,['string'])('');}
  _sweCalc=(jd,planet,flags)=>{const ptr=_sweMod.ccall('swe_calc_ut_wrap','number',['number','number','number'],[jd,planet,flags]);return _sweMod.getValue(ptr,'double');};
  _sweJulday=_sweMod.cwrap('swe_julday_wrap','number',['number','number','number','number','number']);
}

// ─── Ruota dei 64 Gate (identica, universale per ogni specie) ──────────────
const HD_GATE_WHEEL=[41,19,13,49,30,55,37,63,22,36,25,17,21,51,42,3,27,24,2,23,8,20,16,35,45,12,15,52,39,53,62,56,31,33,7,4,29,59,40,64,47,6,46,18,48,57,32,50,28,44,1,43,14,34,9,5,26,11,10,58,38,54,61,60];
const HD_RAVE_OFFSET=58.0;
function hdDegreesToGateLineColor(lon){
  const adj=((lon+HD_RAVE_OFFSET)%360+360)%360;
  const gateIdx=Math.floor(adj/5.625);
  const withinGate=adj-gateIdx*5.625;
  const line=Math.floor(withinGate/0.9375)+1;
  return{gate:HD_GATE_WHEEL[gateIdx],line:Math.min(6,Math.max(1,line))};
}
function dateToJD(y,m,d,h,min,tzOffset){return _sweJulday(y,m,d,h+min/60-tzOffset,1);}
async function calcPlanets(jd){
  await initSwe();
  const SWIEPH=2,results=[];let nnLon=null;
  const PLANET_IDS=[0,1,11,-1,2,3,4,5,6,7,8,9];
  const PLANET_NAMES={0:'Sole',1:'Luna',11:'Nodo Nord',[-1]:'Nodo Sud',2:'Mercurio',3:'Venere',4:'Marte',5:'Giove',6:'Saturno',7:'Urano',8:'Nettuno',9:'Plutone'};
  for(const id of PLANET_IDS){
    let lon;
    if(id===-1){lon=nnLon!==null?(nnLon+180)%360:0;}
    else{lon=_sweCalc(jd,id,SWIEPH);if(id===11)nnLon=lon;}
    const glc=hdDegreesToGateLineColor(lon);
    results.push({planet_it:PLANET_NAMES[id],gate:glc.gate,line:glc.line});
  }
  return results;
}

// ─── Matrice Mammifera (15 porte, fonte: Ra Uru Hu, "The Mammalian Design System", 2002) ──
// Layout spaziale confermato da Illustration 4 "Shadow's Chart" (PDF originale, pag. 27):
// triangolo (28,57,50) + box territorio (38,53,19) + box amicizia (42,27,5) + diamante (15) + gate 1 + box alpha (20,62,8,12)
const MAMMAL_GROUPS=[
  {key:'territory',label:'Territorio',portal:19,
   gates:[{n:19,k:'Territorio'},{n:53,k:'Libertà'},{n:42,k:'Maturità'},{n:38,k:'Fierezza'},{n:28,k:'Paura'}]},
  {key:'metamorphosis',label:'Amicizia (Metamorfosi)',portal:12,
   gates:[{n:12,k:'Metamorfosi'},{n:27,k:'Radunare'},{n:50,k:'Legame'},{n:5,k:'Pattern'},{n:15,k:'Diversità'}]},
  {key:'alpha',label:'Lavoro (Alpha)',portal:62,
   gates:[{n:62,k:"L'Alpha"},{n:20,k:'Presenza'},{n:57,k:'Consapevolezza'},{n:8,k:'Direzione'},{n:1,k:'Individualità'}]},
];
const MAMMAL_CHANNELS=[[53,42],[38,28],[50,27],[5,15],[20,57],[8,1]];
const MAMMAL_LINE_KEYNOTES={1:'Stealth (Cautela)',2:'Mistero',3:'Lotta',4:'Influenza',5:'Attrazione',6:'Separazione'};

async function calculateMammalChart(y,m,d,h,min,tzOffset){
  await initSwe();
  const jdBirth=dateToJD(y,m,d,h,min,tzOffset);
  // Design mammifero: 88 gradi di retrogrado LUNARE (non solare), circa 6 giorni prima della nascita
  const SWIEPH2=2,natalMoonLon=_sweCalc(jdBirth,1,SWIEPH2),targetLon=((natalMoonLon-88)%360+360)%360;
  let lo=jdBirth-10,hi=jdBirth-2;
  for(let i=0;i<60;i++){
    const mid=(lo+hi)/2,midLon=_sweCalc(mid,1,SWIEPH2);
    let diff=(midLon-targetLon+180)%360-180;
    if(Math.abs(diff)<1e-5){lo=hi=mid;break;}
    if(diff<0)lo=mid;else hi=mid;
  }
  const jdDesign=(lo+hi)/2;
  const personality=await calcPlanets(jdBirth),design=await calcPlanets(jdDesign);
  const pMap=new Map(personality.map(p=>[p.gate,p.line])),dMap=new Map(design.map(p=>[p.gate,p.line]));
  const pGates=new Set(pMap.keys()),dGates=new Set(dMap.keys());
  const allActive=new Set([...pGates,...dGates]);
  const definedChannels=MAMMAL_CHANNELS.filter(([g1,g2])=>allActive.has(g1)&&allActive.has(g2));
  const isOpenChart=definedChannels.length===0 && ![19,12,62].some(g=>allActive.has(g));
  const daysToDesign=Math.round((jdBirth-jdDesign)*10)/10;
  return{pGates,dGates,pMap,dMap,definedChannels,isOpenChart,daysToDesign};
}

// ─── Bodygraph SVG (layout reale, Illustration 4) ───────────────────────────
// Posizioni gate: [x,y] su viewBox 0 0 900 480
const GATE_POS={
  28:[230,150], 57:[330,150], 50:[280,220],           // triangolo
  38:[90,300], 53:[180,300], 19:[135,360],             // box territorio
  42:[240,300], 27:[290,300], 5:[340,300],             // box amicizia
  15:[440,320],                                        // diamante
  1:[520,320],                                         // gate singolo
  20:[600,300], 62:[680,300], 8:[600,360], 12:[680,360] // box alpha
};
const GATE_SHAPE={28:'tri',57:'tri',50:'tri',38:'box',53:'box',19:'box',42:'box',27:'box',5:'box',15:'diamond',1:'circle',20:'box',62:'box',8:'box',12:'box'};
const CHANNEL_LINES=[[28,38],[57,20],[50,27],[53,42],[5,15],[1,8]];
const PORTAL_STUBS=[{gate:19,to:[135,430],human:'49'},{gate:12,to:[680,430],human:'22'},{gate:62,to:[790,300],human:'17'}];

function gateFill(gate,pGates,dGates){
  const inP=pGates.has(gate),inD=dGates.has(gate);
  if(inP&&inD)return'#1A2332';
  if(inD)return'#8B2C2C';
  if(inP)return'#1A2332';
  return'#E8E4DE';
}
function buildSVG(chart){
  let svg='<svg viewBox="0 0 900 480" xmlns="http://www.w3.org/2000/svg" font-family="sans-serif">';
  // triangolo di sfondo
  svg+='<polygon points="230,150 330,150 280,220" fill="none" stroke="#DDD" stroke-width="1.5"/>';
  // rettangoli di sfondo per i box (solo decorativi, dietro i cerchi porta)
  svg+='<rect x="70" y="270" width="140" height="90" rx="10" fill="none" stroke="#DDD" stroke-width="1.5"/>';
  svg+='<rect x="220" y="270" width="140" height="60" rx="10" fill="none" stroke="#DDD" stroke-width="1.5"/>';
  svg+='<rect x="580" y="270" width="120" height="90" rx="10" fill="none" stroke="#DDD" stroke-width="1.5"/>';
  svg+='<polygon points="440,290 470,320 440,350 410,320" fill="none" stroke="#DDD" stroke-width="1.5"/>';

  // canali (linee) — colorate se entrambe le porte del canale sono attive
  for(const [g1,g2] of CHANNEL_LINES){
    const isDefined=(chart.pGates.has(g1)||chart.dGates.has(g1)) && (chart.pGates.has(g2)||chart.dGates.has(g2));
    const [x1,y1]=GATE_POS[g1],[x2,y2]=GATE_POS[g2];
    svg+='<line x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="'+(isDefined?'#1A2332':'#DDD')+'" stroke-width="'+(isDefined?4:2)+'"/>';
  }
  // stub porte-ponte (verso l'umano)
  for(const stub of PORTAL_STUBS){
    const [x1,y1]=GATE_POS[stub.gate],[x2,y2]=stub.to;
    const active=chart.pGates.has(stub.gate)||chart.dGates.has(stub.gate);
    svg+='<line x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="'+(active?'#A8722E':'#EEE')+'" stroke-width="2" stroke-dasharray="4,3"/>';
    svg+='<text x="'+x2+'" y="'+(y2+14)+'" font-size="12" fill="#A8722E" text-anchor="middle">'+stub.human+'</text>';
  }
  // porte
  for(const gate in GATE_POS){
    const g=parseInt(gate);
    const [x,y]=GATE_POS[g];
    const fill=gateFill(g,chart.pGates,chart.dGates);
    const r=18;
    svg+='<circle cx="'+x+'" cy="'+y+'" r="'+r+'" fill="'+fill+'" stroke="#fff" stroke-width="2"/>';
    svg+='<text x="'+x+'" y="'+(y+5)+'" font-size="14" font-weight="700" fill="'+(fill==='#E8E4DE'?'#999':'#fff')+'" text-anchor="middle">'+g+'</text>';
  }
  svg+='</svg>';
  return svg;
}

function lineTag(kind,lineNum){
  const keynote=MAMMAL_LINE_KEYNOTES[lineNum]||'';
  const cls=kind==='design'?'mc-badge design':'mc-badge';
  return '<span class="'+cls+'">'+(kind==='design'?'Design':'Personalità')+' &middot; Linea '+lineNum+' ('+keynote+')</span>';
}
function gateBadges(gate,pMap,dMap){
  let out='';
  if(pMap.has(gate))out+=lineTag('personality',pMap.get(gate));
  if(dMap.has(gate))out+=lineTag('design',dMap.get(gate));
  return out;
}

function renderResults(chart){
  const el=document.getElementById('mc-results');
  const name=document.getElementById('mc-name').value.trim()||'Il tuo cane';
  let html='';

  html+='<div class="mc-summary"><h2>'+name+(chart.isOpenChart?': carta aperta':': carta con definizione')+'</h2>';
  html+='<p class="mc-channels">'+(chart.isOpenChart
    ? 'Nessuna porta della matrice mammifera è attiva. Per la fonte originale (Ra Uru Hu), è la condizione più comune: un animale completamente aperto assorbe e riflette il campo di chi ha intorno, il tipo di mammifero più facile da avere in casa.'
    : (chart.definedChannels.length+' canale/i completo/i su 6 possibili. Un mammifero con definizione ha un processo proprio da rispettare, non solo da assecondare.'))
    +' Design calcolato '+Math.abs(chart.daysToDesign)+' giorni prima della nascita (ciclo lunare).</p></div>';

  html+='<div class="mc-svg-wrap">'+buildSVG(chart)+'</div>';

  for(const group of MAMMAL_GROUPS){
    html+='<div class="mc-group"><h3>'+group.label+'</h3>';
    for(const g of group.gates){
      const active=chart.pGates.has(g.n)||chart.dGates.has(g.n);
      const isPortal=g.n===group.portal;
      html+='<div class="mc-gate-row '+(active?'active':'inactive')+'">';
      html+='<span>Porta '+g.n+' &middot; '+g.k+(isPortal?' <span class="mc-portal">(porta-ponte)</span>':'')+'</span>';
      html+='<span>'+(active?gateBadges(g.n,chart.pMap,chart.dMap):'non attiva')+'</span>';
      html+='</div>';
    }
    html+='</div>';
  }

  if(chart.definedChannels.length){
    html+='<div class="mc-group"><h3>Canali completi</h3>';
    for(const [g1,g2] of chart.definedChannels){
      html+='<div class="mc-gate-row active"><span>Canale '+g1+'-'+g2+'</span><span></span></div>';
    }
    html+='</div>';
  }

  el.innerHTML=html;
  el.style.display='block';
}

document.addEventListener('DOMContentLoaded',()=>{
  initCityAutocomplete('mc-city','mc-city-list','mc-tz','mc-tz-detected');
});

document.getElementById('mc-calc-btn').addEventListener('click', async ()=>{
  const errEl=document.getElementById('mc-error');
  errEl.style.display='none';
  const dateVal=document.getElementById('mc-date').value;
  const timeVal=document.getElementById('mc-time').value||'12:00';
  const tz=document.getElementById('mc-tz').value;
  if(!dateVal){errEl.textContent='Inserisci una data di nascita o adozione.';errEl.style.display='block';return;}
  const [y,m,d]=dateVal.split('-').map(Number);
  const [h,min]=timeVal.split(':').map(Number);
  const now=new Date();
  if(y<1990||y>now.getFullYear()){errEl.textContent='Data non valida.';errEl.style.display='block';return;}
  const btn=document.getElementById('mc-calc-btn');
  btn.disabled=true;btn.textContent='Calcolo in corso…';
  try{
    const localDt=new Date(y,m-1,d,h,min);
    const tzDate=new Date(localDt.toLocaleString('en-US',{timeZone:tz}));
    const utcDate=new Date(localDt.toLocaleString('en-US',{timeZone:'UTC'}));
    const tzOffset=(tzDate-utcDate)/3600000;
    const chart=await calculateMammalChart(y,m,d,h,min,tzOffset);
    renderResults(chart);
  }catch(e){
    errEl.textContent='Errore nel calcolo: '+e.message;errEl.style.display='block';
  }finally{
    btn.disabled=false;btn.textContent='Calcola la Mammal Chart';
  }
});
</script>
{% endblock %}
