{% extends 'partials/base.html.twig' %}

{% block title %}{{ page.header.seo_title ?? page.title }} | Valentina Russo{% endblock %}

{# ══════════════════════════════════════════════════════════════════════════════
   GUARD — Logica immagine articolo. NON modificare senza leggere.
   ⚠️  REGOLA: NON usare "grav.base_url_absolute ~" davanti ai path immagine.
       Restituisce stringa vuota in questo contesto → src="" → immagine rotta su TUTTI gli articoli.
   Ordine priorità:
     0. featured_image con /user/pages/ → estrai filename → cerca in page.media
     1. featured_image filename semplice (es: mia-foto.jpg) → cerca in page.media
     2. Prima immagine in page.media (upload via Admin) — automatico, nessun campo richiesto
     3. featured_image percorso assoluto (es: /user/images/blog/blog-1.png) → usato direttamente
══════════════════════════════════════════════════════════════════════════════ #}
{% set art_img = '' %}
{# 0. featured_image con path /user/pages/ → estrai filename e cerca nei media #}
{% if page.header.featured_image is defined and page.header.featured_image and '/user/pages/' in page.header.featured_image %}
  {% set _fname = page.header.featured_image|split('/')|last %}
  {% if page.media[_fname] is defined %}{% set art_img = page.media[_fname].url %}{% endif %}
{% endif %}
{# 1. featured_image filename semplice → lookup diretto nei media #}
{% if not art_img and page.header.featured_image is defined and page.header.featured_image and '/' not in page.header.featured_image %}
  {% set art_img = page.media[page.header.featured_image].url ?? '' %}
{% endif %}
{# 2. Prima media della pagina (page.media|first funziona sulla pagina corrente) #}
{% if not art_img and page.media|length %}
  {% set art_img = page.media|first.url ?? '' %}
{% endif %}
{# 3. featured_image percorso assoluto legacy — MAI /user/pages/ che non è URL pubblico #}
{% if not art_img and page.header.featured_image is defined and page.header.featured_image and '/user/pages/' not in page.header.featured_image %}
  {% set art_img = page.header.featured_image %}
{% endif %}

{% block schema %}
{# Article LD+JSON #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ page.title|json_encode|raw }},
  "description": {{ (page.header.description ?? '')|json_encode|raw }},
  {% if page.header.aeo_answer is defined and page.header.aeo_answer %}"abstract": {{ page.header.aeo_answer|json_encode|raw }},{% endif %}
  {% if page.header.geo_content is defined and page.header.geo_content %}"backstory": {{ (page.header.geo_content is iterable ? page.header.geo_content|join(' ') : page.header.geo_content)|json_encode|raw }},{% endif %}
  {% if page.header.tags is defined and page.header.tags %}"keywords": {{ (page.header.tags is iterable ? page.header.tags|join(', ') : page.header.tags)|json_encode|raw }},{% endif %}
  "datePublished": "{{ page.date|date('c') }}",
  "dateModified": "{{ page.modified|date('c') }}",
  "url": "{{ page.url(true) }}",
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ page.url(true) }}" },
  "author": {
    "@type": "Person",
    "name": "Valentina Russo",
    "url": "{{ grav.base_url_absolute }}/chi-sono",
    "jobTitle": "Consulente Certificata BG5® e Human Design",
    "sameAs": [
      "https://www.instagram.com/valentinarussobg5/",
      "{{ grav.base_url_absolute }}"
    ]
  },
  "publisher": {
    "@type": "Organization",
    "name": "Valentina Russo",
    "url": "{{ grav.base_url_absolute }}",
    "sameAs": ["https://www.instagram.com/valentinarussobg5/"]
  },
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".aeo-answer-box", "h1", ".blog-article-body > p:first-child"]
  }{% if art_img %},
  "image": "{{ art_img }}"{% endif %}
}
</script>

{# FAQ LD+JSON #}
{% if page.header.faq is defined and page.header.faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for faq in page.header.faq %}
    {
      "@type": "Question",
      "name": {{ (faq.question ?? faq.q)|json_encode|raw }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ (faq.answer ?? faq.a)|json_encode|raw }}
      }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{# BreadcrumbList LD+JSON #}
{% set is_corp = '/aziende/' in page.route %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "{{ grav.base_url_absolute }}{{ is_corp ? '/aziende' : '' }}"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "{{ grav.base_url_absolute }}{{ is_corp ? '/aziende/blog' : '/blog' }}"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ page.title|json_encode|raw }},
      "item": "{{ page.url(true) }}"
    }
  ]
}
</script>
{% endblock %}

{% block extra_css %}
<link rel="stylesheet" href="{{ theme_url }}/css/d2/articolo-d2.css?v={{ theme_version }}">
{% endblock %}

{% block content %}
{% set base = grav.base_url %}
{% set corp = '/aziende/' in page.route %}
<article class="art">
  <header class="art-testa"><div class="wrap">
    <a class="art-torna lnk" href="{{ base }}/{{ corp ? 'aziende/blog' : 'blog' }}">&larr; Torna al Blog{{ corp ? ' Aziende' : '' }}</a>
    {% if page.header.tags is defined and page.header.tags %}
    <div class="art-tags">{% for tag in (page.header.tags is iterable ? page.header.tags : page.header.tags|split(',')) %}<span class="art-tag">{{ tag|trim }}</span>{% endfor %}</div>
    {% endif %}
    <h1>{{ page.title }}</h1>
    <p class="art-meta">{{ page.date|date("d M Y") }}{% if page.header.author is defined %} &mdash; {{ page.header.author }}{% endif %}</p>
    {% if page.header.description is defined %}<p class="art-sommario">{{ page.header.description }}</p>{% endif %}
  </div></header>

  {% if art_img %}
  <figure class="art-figura wrap"><img src="{{ art_img }}" alt="{{ page.header.image_alt ?? page.title }}" class="featured-image"></figure>
  {% endif %}

  <div class="wrap art-colonna">
    {% if page.header.aeo_answer is defined and page.header.aeo_answer %}
    <aside class="art-risposta"><p>{{ page.header.aeo_answer }}</p></aside>
    {% endif %}

    <div class="art-corpo blog-article-body">{{ page.content|raw }}</div>

    {% if page.header.faq is defined and page.header.faq %}
    <section class="art-domande">
      <h3>Domande Frequenti</h3>
      {% for faq in page.header.faq %}
      <details class="art-faq"><summary>{{ faq.question ?? faq.q }}</summary><p>{{ faq.answer ?? faq.a }}</p></details>
      {% endfor %}
    </section>
    {% endif %}

    {% if page.header.geo_content is defined and page.header.geo_content %}
    {% set geo = page.header.geo_content %}
    <section class="art-appro">
      <p class="etich">Approfondimenti</p>
      {% if geo is iterable %}<ul>{% for item in geo %}<li>{{ item }}</li>{% endfor %}</ul>{% else %}<p>{{ geo }}</p>{% endif %}
    </section>
    {% endif %}

    <section class="card art-cta rivela">
      {% if corp %}
      <h3>Vuoi portare il BG5&reg; nella tua azienda?</h3>
      <p>Se vuoi capire come si applica alla tua realt&agrave;, scopri i servizi disponibili. Se sai gi&agrave; cosa cerchi, prenota una consulenza diretta.</p>
      <div class="azioni"><a class="btn btn-2" href="{{ base }}/aziende/servizi">Scopri i servizi</a><a class="btn btn-1" href="{{ base }}/aziende/contatti">Richiedi una Consulenza</a></div>
      {% else %}
      <h3>Vuoi scoprire la tua meccanica?</h3>
      <p>Se non conosci ancora il tuo Tipo, calcola gratis la tua carta in pochi secondi. Se lo sai gi&agrave;, prenota una Panoramica BG5&reg; e scopri come funziona nel tuo caso specifico.</p>
      <div class="azioni"><a class="btn btn-2" href="{{ base }}/calcolo-human-design">Fai il calcolo Human Design gratis</a><a class="btn btn-1" href="{{ base }}/servizi">Prenota una Panoramica BG5&reg;</a></div>
      {% endif %}
    </section>
  </div>

  {# altri articoli: stessa selezione di prima, veste nuova #}
  {% set related = [] %}
  {% for child in page.parent.children %}
    {% if child.published and child.id != page.id and child.header.published is not same as(false) and related|length < 3 %}
      {% set related = related|merge([child]) %}
    {% endif %}
  {% endfor %}
  {% if related|length %}
  <section class="art-correlati"><div class="wrap">
    <h3>Continua a leggere</h3>
    <div class="griglia">
      {% for r in related %}
      {% set media = r.media|length ? r.media|first : null %}
      <a class="card art-rel rivela" href="{{ r.url }}">
        {% if media %}<span class="art-rel-img"><img src="{{ media.cropZoom(760,475).quality(82).url }}" alt="{{ r.header.image_alt ?? r.title }}" loading="lazy" width="760" height="475"></span>{% endif %}
        <span class="art-rel-corpo"><h4>{{ r.title }}</h4>{% if r.header.description %}<p>{{ r.header.description|truncate(140, true, '&hellip;') }}</p>{% endif %}<span class="lnk">Leggi articolo &rarr;</span></span>
      </a>
      {% endfor %}
    </div>
  </div></section>
  {% endif %}

  {% if not corp %}
  <section class="art-citta"><div class="wrap">
    <p class="etich">Consulenze BG5&reg; disponibili in tutta Italia</p>
    <p class="righe"><a href="{{ base }}/consulente-bg5-milano">Milano</a> &middot; <a href="{{ base }}/consulente-bg5-torino">Torino</a> &middot; <a href="{{ base }}/consulente-bg5-roma">Roma</a> &middot; <a href="{{ base }}/consulente-bg5-bologna">Bologna</a> &middot; <a href="{{ base }}/consulente-bg5-firenze">Firenze</a> &middot; <a href="{{ base }}/consulente-bg5-napoli">Napoli</a> &middot; <a href="{{ base }}/consulente-bg5-venezia">Venezia</a> &middot; <a href="{{ base }}/consulente-bg5-bari">Bari</a> &middot; <a href="{{ base }}/consulente-bg5-palermo">Palermo</a> &middot; <a href="{{ base }}/consulente-bg5-verona">Verona</a> &middot; <a href="{{ base }}/consulente-bg5-italia">Tutta Italia &rarr;</a></p>
  </div></section>
  {% endif %}
</article>
{% endblock %}
